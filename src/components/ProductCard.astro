---
import type { ProdutoPublicado } from "../lib/produtos";
import {
  resumoCurvaturas,
  rotuloCategoria
} from "../lib/produtos";

interface Props {
  produto: ProdutoPublicado;
  compacto?: boolean;
}

const { produto, compacto = false } = Astro.props;
const initials = produto.marca
  .split(/\s+/)
  .map((parte) => parte[0])
  .join("")
  .slice(0, 2);
---

<article class:list={["product-card", { "is-compact": compacto }]}>
  <a class="product-card-visual" href={`/produtos/${produto.id}/`} aria-hidden="true" tabindex="-1">
    <span class="product-monogram">{initials}</span>
    <span class="product-shape"></span>
    <span class="product-kind">{rotuloCategoria(produto.categoria)}</span>
  </a>

  <div class="product-card-content">
    <p class="product-brand">{produto.marca}</p>
    <h3><a href={`/produtos/${produto.id}/`}>{produto.nome}</a></h3>
    <p class="product-summary">{produto.descricao}</p>

    <dl class="product-card-facts">
      <div>
        <dt>Para quem</dt>
        <dd>{resumoCurvaturas(produto.perfil.curvaturas)}</dd>
      </div>
      <div>
        <dt>Textura</dt>
        <dd>{produto.perfil.textura}</dd>
      </div>
    </dl>

    <div class="product-card-footer">
      <span class="evidence-pill">
        {produto.analise.testado ? "Teste real" : "Análise documental"}
      </span>
      <a class="arrow-link" href={`/produtos/${produto.id}/`}>
        Ver ficha <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>
