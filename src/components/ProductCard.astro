---
import type { ProdutoPublicado } from "../lib/produtos";
import {
  custoPorCemProduto,
  faixaDePreco,
  resumoObjetivos,
  rotuloCategoria,
  linkCompraProduto
} from "../lib/produtos";

interface Props {
  produto: ProdutoPublicado;
  compacto?: boolean;
}

const { produto, compacto = false } = Astro.props;
const tamanhoEncontrado = produto.nome.match(/\s(\d+(?:[.,]\d+)?\s?(?:g|kg|ml|l))$/i);
const tamanho = tamanhoEncontrado?.[1] ?? "";
let nomePrincipal = tamanhoEncontrado
  ? produto.nome.slice(0, tamanhoEncontrado.index).trim()
  : produto.nome;
nomePrincipal = nomePrincipal.replace(
  new RegExp(`^${produto.marca.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\s+`, "i"),
  ""
);
if (produto.categoria === "gelatina") {
  nomePrincipal = nomePrincipal.replace(/^Gelatina\s+/i, "");
}
if (produto.categoria === "creme_para_pentear") {
  nomePrincipal = nomePrincipal.replace(/\s+Creme de Pentear$/i, "");
}
const tipoProduto = rotuloCategoria(produto.categoria);
const preco = faixaDePreco(produto);
const custoPorCem = custoPorCemProduto(produto);
const melhorPara = resumoObjetivos(produto.perfil.objetivos);
const linkCompra = linkCompraProduto(produto);
if (!linkCompra) {
  throw new Error(`O produto "${produto.id}" precisa de um link de compra.`);
}
---

<article class:list={["product-card", { "is-compact": compacto }]}>
  <a class="product-card-visual" href={`/produtos/${produto.id}/`} aria-hidden="true" tabindex="-1">
    {
      produto.imagem ? (
        <img
          class="product-photo"
          src={produto.imagem.src}
          alt={produto.imagem.alt}
          width="640"
          height="640"
          loading="lazy"
        />
      ) : (
        <>
          <span class="product-shape"></span>
          <span class="product-shape-small"></span>
        </>
      )
    }
  </a>

  <div class="product-card-content">
    <div class="product-kicker">
      <p class="product-brand">{produto.marca}</p>
      <span>{tipoProduto}</span>
    </div>
    <h3>
      <a href={`/produtos/${produto.id}/`} aria-label={produto.nome}>
        <span>{nomePrincipal}</span>
        {tamanho && <small>{tamanho}</small>}
      </a>
    </h3>
    <p class="product-summary">{produto.descricao}</p>

    {
      preco && (
        <p class="product-price">
          <strong>{preco}</strong>
          {custoPorCem && <span>{custoPorCem}</span>}
        </p>
      )
    }

    {
      !compacto && (
        <dl class="product-card-facts">
          {melhorPara && (
            <div>
              <dt>Melhor para</dt>
              <dd>{melhorPara}</dd>
            </div>
          )}
          <div>
            <dt>Textura</dt>
            <dd>{produto.perfil.textura}</dd>
          </div>
        </dl>
      )
    }

    <div class="product-card-actions">
      <a class="product-detail-link" href={`/produtos/${produto.id}/`}>
        Ver detalhes
      </a>
      <a
        class="button button-primary purchase-button product-buy-button"
        href={linkCompra}
        target="_blank"
        rel="nofollow sponsored noopener"
      >
        Quero esse produto
      </a>
    </div>
  </div>
</article>
