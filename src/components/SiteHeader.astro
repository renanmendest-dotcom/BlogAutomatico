---
const pathname = Astro.url.pathname;
const links = [
  { href: "/artigos/", label: "Guias" },
  { href: "/produtos/", label: "Produtos" },
  { href: "/sobre/", label: "Sobre" }
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Curva Viva, página inicial">
      <span class="brand-symbol" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="brand-type">Curva Viva</span>
    </a>

    <nav aria-label="Navegação principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={pathname.startsWith(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <a
        class="header-search"
        href="/busca/"
        aria-current={pathname.startsWith("/busca") ? "page" : undefined}
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <circle cx="7" cy="7" r="4.75"></circle>
          <path d="M10.5 10.5 L14.5 14.5" stroke-linecap="round"></path>
        </svg>
        <span>Buscar</span>
      </a>
    </nav>
  </div>
</header>
