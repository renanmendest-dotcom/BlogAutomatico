---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site as dadosDoSite } from "../lib/site";
import "../styles/global.css";

interface Props {
  titulo?: string;
  descricao?: string;
  noindex?: boolean;
  tipo?: "website" | "article";
}

const {
  titulo,
  descricao = "Guias e fichas para escolher produtos para cabelos ondulados, cacheados e crespos com mais clareza.",
  noindex = false,
  tipo = "website"
} = Astro.props;

const siteName = "Curva Viva";
const pageTitle = titulo
  ? `${titulo} | ${siteName}`
  : `${siteName} | Seu cabelo, com escolhas mais claras`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
const base = Astro.site?.toString().replace(/\/$/, "") ?? "";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${base}/#organizacao`,
  name: siteName,
  url: Astro.site?.toString(),
  logo: new URL("/logo-curva-viva.png", Astro.site).toString(),
  description:
    "Curadoria independente de produtos e guias para cabelos ondulados, cacheados e crespos."
};

// WebSite com busca interna. Só é honesto declarar porque /busca/ existe e
// aceita o parâmetro q de verdade.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${base}/#site`,
  name: siteName,
  url: Astro.site?.toString(),
  inLanguage: "pt-BR",
  publisher: { "@id": `${base}/#organizacao` },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${base}/busca/?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content={dadosDoSite.googleSiteVerification}
    />
    <meta name="msvalidate.01" content={dadosDoSite.bingSiteVerification} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f1e9" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
