---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout titulo="Página não encontrada" noindex>
  <section class="not-found shell">
    <p class="error-code">404 / NÃO LOCALIZADO</p>
    <h1>Esta combinação não existe.</h1>
    <p>A página pode ter mudado ou o endereço foi digitado incorretamente.</p>
    <a class="button button-primary" href="/">Voltar ao início</a>
  </section>
</BaseLayout>
