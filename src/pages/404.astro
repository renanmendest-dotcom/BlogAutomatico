---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  titulo="Página não encontrada"
  descricao="Esta página não foi encontrada."
  noindex
>
  <section class="not-found shell">
    <p class="eyebrow">Erro 404</p>
    <h1>Esse fio se perdeu pelo caminho.</h1>
    <p>
      A página pode ter mudado de endereço. Volte ao início ou encontre um guia
      para continuar sua pesquisa.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/">Voltar ao início</a>
      <a class="text-link" href="/artigos/">Ver os guias ↗</a>
    </div>
  </section>
</BaseLayout>
