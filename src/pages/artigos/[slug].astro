---
import { getCollection } from "astro:content";
import { marked } from "marked";
import ProductRecommendationCard from "../../components/ProductRecommendationCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buscarProduto,
  formatarData,
  rotuloCategoria
} from "../../lib/produtos";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((post) => !post.data.rascunho)
    .map((post) => ({
      params: { slug: post.id },
      props: { post }
    }));
}

function escaparHtml(valor: string) {
  return valor
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function criarSlug(valor: string) {
  return valor
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLocaleLowerCase("pt-BR")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const { post } = Astro.props;
const corpoMarkdown = post.body ?? "";
const blocosDoCorpo = corpoMarkdown.split(/(?=^##\s+)/m).filter(Boolean);
const primeiroBlocoTemTitulo = /^##\s+/m.test(blocosDoCorpo[0] ?? "");
const quantidadeBlocosIniciais = primeiroBlocoTemTitulo ? 2 : 3;
const markdownInicial = blocosDoCorpo
  .slice(0, quantidadeBlocosIniciais)
  .join("");
const markdownContinuacao = blocosDoCorpo
  .slice(quantidadeBlocosIniciais)
  .join("");

const idsUsados = new Map<string, number>();
const secoes = [...corpoMarkdown.matchAll(/^##\s+(.+)$/gm)].map((resultado) => {
  const titulo = resultado[1].trim();
  const base = criarSlug(titulo);
  const repeticoes = idsUsados.get(base) ?? 0;
  idsUsados.set(base, repeticoes + 1);
  return {
    titulo,
    id: repeticoes === 0 ? base : `${base}-${repeticoes + 1}`
  };
});

let indiceSecao = 0;
function renderizarTrecho(markdown: string) {
  const markdownComIds = markdown.replace(/^##\s+(.+)$/gm, (_, titulo) => {
    const secao = secoes[indiceSecao++];
    return `<h2 id="${secao.id}">${escaparHtml(titulo.trim())}</h2>`;
  });
  return marked.parse(markdownComIds, { gfm: true }) as string;
}

const htmlInicial = renderizarTrecho(markdownInicial);
const htmlContinuacao = renderizarTrecho(markdownContinuacao);

const recomendacoes = post.data.recomendacoes
  .map((recomendacao) => ({
    ...recomendacao,
    produtoEncontrado: buscarProduto(recomendacao.produto)
  }))
  .filter((recomendacao) => recomendacao.produtoEncontrado);
const recomendacaoPrincipal = recomendacoes[0];
const produtoPrincipal = recomendacaoPrincipal?.produtoEncontrado;

const rotulosModelo = {
  educativo: "Guia educativo",
  analise: "Análise de produto",
  comparativo: "Comparativo"
};
const titulosRecomendacao = {
  educativo: "Uma opção para colocar a técnica em prática.",
  analise: "O produto analisado, com os detalhes que importam.",
  comparativo: "As opções que representam cada lado da comparação."
};
const textosRecomendacao = {
  educativo:
    "A indicação entra aqui porque você já entendeu a técnica e consegue avaliar se ela combina com a sua rotina.",
  analise:
    "Agora que a proposta e os limites ficaram claros, veja para quem o produto faz mais sentido e por quê.",
  comparativo:
    "Cada opção cumpre uma função diferente. Compare a indicação e escolha pelo resultado que está faltando."
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.titulo,
  description: post.data.descricao,
  datePublished: post.data.publicado_em.toISOString(),
  dateModified: post.data.atualizado_em.toISOString(),
  articleSection: secoes.map((secao) => secao.titulo),
  author: {
    "@type": "Organization",
    name: post.data.autor
  },
  publisher: {
    "@type": "Organization",
    name: "Curva Viva"
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString()
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: post.data.perguntas_frequentes.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.resposta
    }
  }))
};
---

<BaseLayout
  titulo={post.data.titulo}
  descricao={post.data.descricao}
  tipo="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class:list={["article-template", `is-${post.data.modelo_artigo}`]}>
    <header class="article-hero">
      <div class="shell article-hero-inner">
        <a class="back-link" href="/artigos/">← Todos os guias</a>
        <p class="eyebrow">
          {rotulosModelo[post.data.modelo_artigo]} | {rotuloCategoria(post.data.categoria)}
        </p>
        <h1>{post.data.titulo}</h1>
        <div class="article-heading-meta">
          <span>Por {post.data.autor}</span>
          <time datetime={post.data.atualizado_em.toISOString()}>
            Atualizado em {formatarData(post.data.atualizado_em)}
          </time>
        </div>
        <p class="answer-box">{post.data.resposta_curta}</p>
      </div>
    </header>

    <div class="shell article-body-grid">
      <div class="prose article-prose">
        <nav class="article-toc" aria-labelledby="titulo-sumario">
          <p class="eyebrow">Leitura fácil</p>
          <h2 id="titulo-sumario">Neste artigo você vai descobrir</h2>
          <ol>
            {
              secoes.map((secao) => (
                <li><a href={`#${secao.id}`}>{secao.titulo}</a></li>
              ))
            }
            <li><a href="#perguntas-frequentes">Dúvidas frequentes</a></li>
            <li><a href="#conclusao">Conclusão</a></li>
          </ol>
        </nav>

        {
          produtoPrincipal && (
            <p class="quick-recommendation">
              <strong>Recomendação rápida:</strong> {produtoPrincipal.nome}.{" "}
              <a href="#recomendacao-completa">
                Veja a análise completa mais abaixo ↓
              </a>
            </p>
          )
        }

        <div class="article-editorial-part" set:html={htmlInicial} />

        {
          recomendacoes.length > 0 && (
            <section
              class:list={[
                "article-context-recommendation",
                { "has-comparison": recomendacoes.length > 1 }
              ]}
              id="recomendacao-completa"
              aria-labelledby="titulo-recomendacao"
            >
              <h2 id="titulo-recomendacao">
                {titulosRecomendacao[post.data.modelo_artigo]}
              </h2>
              <p>{textosRecomendacao[post.data.modelo_artigo]}</p>

              <div class="context-product-grid">
                {
                  recomendacoes.map((recomendacao) =>
                    recomendacao.produtoEncontrado ? (
                      <ProductRecommendationCard
                        produto={recomendacao.produtoEncontrado}
                        melhorIndicacao={recomendacao.melhor_indicacao}
                        motivo={recomendacao.motivo}
                        pontosPositivos={recomendacao.pontos_positivos}
                      />
                    ) : null
                  )
                }
              </div>
            </section>
          )
        }

        <div class="article-editorial-part article-editorial-continuation" set:html={htmlContinuacao} />

        <section class="faq-section" id="perguntas-frequentes">
          <p class="eyebrow">Perguntas rápidas</p>
          <h2>Dúvidas frequentes</h2>
          <dl>
            {
              post.data.perguntas_frequentes.map((item) => (
                <div>
                  <dt>{item.pergunta}</dt>
                  <dd>{item.resposta}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="article-conclusion" id="conclusao">
          <p class="eyebrow">Para fechar</p>
          <h2>Qual é a resposta final?</h2>
          <p>{post.data.conclusao}</p>
        </section>

        <section class="article-sources">
          <p class="eyebrow">Para conferir</p>
          <h2>De onde vieram as informações?</h2>
          <ol>
            {
              post.data.fontes.map((fonte) => (
                <li>
                  <a href={fonte.url} target="_blank" rel="noopener">
                    {fonte.titulo}
                  </a>
                </li>
              ))
            }
          </ol>
        </section>

        {
          produtoPrincipal && (
            <aside class="article-secondary-cta" aria-label="Consultar produto recomendado">
              <p>
                Quer rever a indicação?{" "}
                <a href="#recomendacao-completa">Voltar ao produto ↑</a>
              </p>
            </aside>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
