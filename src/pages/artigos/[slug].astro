---
import { getCollection, render } from "astro:content";
import ProductCard from "../../components/ProductCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buscarProduto,
  rotuloCategoria
} from "../../lib/produtos";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((post) => !post.data.rascunho)
    .map((post) => ({
      params: { slug: post.id },
      props: { post }
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const produtos = post.data.produtos
  .map((id: string) => buscarProduto(id))
  .filter(Boolean);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.titulo,
  description: post.data.descricao,
  datePublished: post.data.publicado_em.toISOString(),
  dateModified: post.data.atualizado_em.toISOString(),
  author: {
    "@type": "Organization",
    name: post.data.autor
  },
  publisher: {
    "@type": "Organization",
    name: "Curva Viva"
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString()
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: post.data.perguntas_frequentes.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.resposta
    }
  }))
};
---

<BaseLayout
  titulo={post.data.titulo}
  descricao={post.data.descricao}
  tipo="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article>
    <header class="article-hero">
      <div class="shell article-hero-inner">
        <a class="back-link" href="/artigos/">← Todos os guias</a>
        <p class="eyebrow">{rotuloCategoria(post.data.categoria)} sem complicação</p>
        <h1>{post.data.titulo}</h1>
        <p class="answer-box">{post.data.resposta_curta}</p>
        <p class="article-byline">Por {post.data.autor}</p>
      </div>
    </header>

    <div class="shell article-body-grid">
      <div class="prose">
        {
          produtos.length > 0 && (
            <section class="article-product-recommendations" aria-labelledby="produtos-citados">
              <p class="eyebrow">Para colocar em prática</p>
              <h2 id="produtos-citados">Os produtos que fazem sentido aqui</h2>
              <p>
                Quer testar essa finalização? Separei as opções citadas no guia
                para você não precisar sair caçando o nome certinho por aí.
              </p>
              <div class="article-product-grid">
                {produtos.map((produto) =>
                  produto ? <ProductCard produto={produto} compacto /> : null
                )}
              </div>
            </section>
          )
        }

        <Content />

        <section class="faq-section">
          <p class="eyebrow">Perguntas rápidas</p>
          <h2>Dúvidas frequentes</h2>
          <dl>
            {
              post.data.perguntas_frequentes.map((item) => (
                <div>
                  <dt>{item.pergunta}</dt>
                  <dd>{item.resposta}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="article-sources">
          <p class="eyebrow">Para conferir</p>
          <h2>De onde vieram as informações?</h2>
          <ol>
            {
              post.data.fontes.map((fonte) => (
                <li>
                  <a href={fonte.url} target="_blank" rel="noopener">
                    {fonte.titulo}
                  </a>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

    </div>
  </article>
</BaseLayout>
