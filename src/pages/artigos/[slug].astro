---
import { getCollection, render } from "astro:content";
import ProductCard from "../../components/ProductCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buscarProduto,
  formatarData,
  rotuloCategoria
} from "../../lib/produtos";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((post) => !post.data.rascunho)
    .map((post) => ({
      params: { slug: post.id },
      props: { post }
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const produtos = post.data.produtos
  .map((id: string) => buscarProduto(id))
  .filter(Boolean);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.titulo,
  description: post.data.descricao,
  datePublished: post.data.publicado_em.toISOString(),
  dateModified: post.data.atualizado_em.toISOString(),
  author: {
    "@type": "Organization",
    name: post.data.autor
  },
  publisher: {
    "@type": "Organization",
    name: "Curva Viva"
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString()
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: post.data.perguntas_frequentes.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.resposta
    }
  }))
};
---

<BaseLayout
  titulo={post.data.titulo}
  descricao={post.data.descricao}
  tipo="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article>
    <header class="article-hero">
      <div class="shell article-hero-inner">
        <a class="back-link" href="/artigos/">← Todos os guias</a>
        <p class="eyebrow">
          {rotuloCategoria(post.data.categoria)} · {
            post.data.tipo_analise === "teste_real"
              ? "teste real"
              : "análise documental"
          }
        </p>
        <h1>{post.data.titulo}</h1>
        <p class="answer-box">{post.data.resposta_curta}</p>
        <dl class="article-meta">
          <div>
            <dt>Por</dt>
            <dd>{post.data.autor}</dd>
          </div>
          <div>
            <dt>Atualizado</dt>
            <dd>{formatarData(post.data.atualizado_em)}</dd>
          </div>
          <div>
            <dt>Fontes verificadas</dt>
            <dd>{post.data.fontes.length}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="shell article-body-grid">
      <div class="prose">
        {
          produtos.length > 0 && (
            <section class="article-product-recommendations" aria-labelledby="produtos-citados">
              <p class="eyebrow">Produtos citados neste guia</p>
              <h2 id="produtos-citados">Opções que combinam com esta orientação.</h2>
              <p>
                Estes produtos foram incluídos porque suas fichas publicadas se
                relacionam com a dúvida respondida. A indicação não significa
                que o resultado será igual em todos os cabelos.
              </p>
              <div class="article-product-grid">
                {produtos.map((produto) =>
                  produto ? <ProductCard produto={produto} compacto /> : null
                )}
              </div>
            </section>
          )
        }

        <Content />

        <section class="faq-section">
          <p class="eyebrow">Perguntas rápidas</p>
          <h2>Dúvidas frequentes</h2>
          <dl>
            {
              post.data.perguntas_frequentes.map((item) => (
                <div>
                  <dt>{item.pergunta}</dt>
                  <dd>{item.resposta}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="article-sources">
          <p class="eyebrow">Rastreabilidade</p>
          <h2>Fontes consultadas</h2>
          <ol>
            {
              post.data.fontes.map((fonte) => (
                <li>
                  <a href={fonte.url} target="_blank" rel="noopener">
                    {fonte.titulo}
                  </a>
                  <span>Acesso em {formatarData(fonte.acessado_em)}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="article-aside">
        <div class="method-note">
          <p class="eyebrow">Como ler este guia</p>
          <p>
            Este conteúdo organiza informações publicadas pelas marcas. Quando
            não existe teste real da Curva Viva, não apresentamos resultado
            pessoal como fato.
          </p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
