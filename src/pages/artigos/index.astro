---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.rascunho)
  .sort(
    (a, b) =>
      b.data.atualizado_em.getTime() - a.data.atualizado_em.getTime()
  );
---

<BaseLayout
  titulo="Guias para escolher produtos capilares"
  descricao="Respostas diretas, comparações e fontes para escolher finalizadores e tratamentos para cabelos texturizados."
>
  <header class="page-hero shell">
    <p class="eyebrow">Guias da Curva Viva</p>
    <h1>Sua dúvida provavelmente mora aqui.</h1>
    <p>
      Cabelo pesou? A definição sumiu? Não sabe qual produto escolher? Calma.
      Tem resposta direta e passo a passo sem aquela conversa enrolada.
    </p>
  </header>

  <section class="section shell section-first">
    <div class="article-list">
      {
        posts.map((post, index) => (
          <ArticleCard post={post} destaque={index === 0} />
        ))
      }
    </div>
  </section>

  <section class="editorial-callout">
    <div class="shell callout-inner">
      <p>Não encontrou sua dúvida?</p>
      <strong>
        Volte daqui a pouco. A Curva Viva sempre ganha um guia novo para resolver
        aquelas perguntas que aparecem bem na hora da finalização.
      </strong>
    </div>
  </section>
</BaseLayout>
