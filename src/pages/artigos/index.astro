---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.rascunho)
  .sort(
    (a, b) =>
      b.data.atualizado_em.getTime() - a.data.atualizado_em.getTime()
  );
---

<BaseLayout
  titulo="Guias para escolher produtos capilares"
  descricao="Respostas diretas, comparações e fontes para escolher finalizadores e tratamentos para cabelos texturizados."
>
  <header class="page-hero shell">
    <p class="eyebrow">Guias da Curva Viva</p>
    <h1>Entenda antes de colocar no carrinho.</h1>
    <p>
      Perguntas reais, resposta curta no início e detalhes suficientes para
      você decidir sem decorar linguagem de rótulo.
    </p>
  </header>

  <section class="section shell section-first">
    <div class="article-list">
      {
        posts.map((post, index) => (
          <ArticleCard post={post} destaque={index === 0} />
        ))
      }
    </div>
  </section>

  <section class="editorial-callout">
    <div class="shell callout-inner">
      <p>Não encontrou sua dúvida?</p>
      <strong>
        A pesquisa automática procura novas perguntas toda semana. O artigo só
        entra no site depois da aprovação humana.
      </strong>
    </div>
  </section>
</BaseLayout>
