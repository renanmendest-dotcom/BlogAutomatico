---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIAS } from '../../consts';
import { breadcrumb } from '../../lib/schema';

const posts = await getCollection('posts');

const categorias = Object.values(CATEGORIAS).map((c) => ({
  ...c,
  total: posts.filter((p) => p.data.categoria === c.slug).length,
}));
---

<Base
  titulo="Categorias"
  descricao="Iluminação, tomadas, assistentes, sensores e hubs — as cinco famílias de dispositivo cobertas pelas fichas de compatibilidade."
  nosSchema={[breadcrumb([{ nome: 'Início', caminho: '/' }, { nome: 'Categorias', caminho: '/categorias' }])]}
>
  <h1>Categorias</h1>

  <ul class="lista">
    {
      categorias.map((c) => (
        <li>
          <h2><a href={`/categorias/${c.slug}`}>{c.nome}</a></h2>
          <p>{c.descricao}</p>
          <p class="dado contagem">{c.total} artigo{c.total === 1 ? '' : 's'}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .lista {
    list-style: none;
    padding: 0;
  }

  .lista li {
    border-top: var(--borda);
    padding: 1rem 0;
  }

  .lista h2 {
    border: 0;
    padding: 0;
    margin: 0 0 0.25rem;
  }

  .lista p {
    margin: 0;
  }

  .contagem {
    font-size: 0.75rem;
    color: var(--nulo);
    margin-top: 0.35rem;
  }
</style>
