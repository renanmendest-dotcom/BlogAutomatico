---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import ProductCard from "../components/ProductCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  produtosNaFila,
  produtosPublicados
} from "../lib/produtos";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.rascunho)
  .sort(
    (a, b) =>
      b.data.atualizado_em.getTime() - a.data.atualizado_em.getTime()
  );
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span> base em construção, dados abertos</p>
        <h1>Antes de comprar,<br /><em>confira se combina.</em></h1>
        <p class="hero-lead">
          Compatibilidade de casa inteligente sem palpite. Cada resposta mostra
          a fonte, a data e também o que ainda não foi possível confirmar.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/produtos/">Consultar produtos</a>
          <a class="button button-secondary" href="/como-verificamos/">Entender os dados</a>
        </div>
      </div>

      <aside class="instrument-panel" aria-label="Estado da base">
        <div class="instrument-header">
          <span>STATUS DA BASE</span>
          <span>BR / 01</span>
        </div>
        <div class="instrument-display">
          <span class="instrument-number">{produtosPublicados.length}</span>
          <span class="instrument-unit">fichas públicas</span>
        </div>
        <dl class="instrument-list">
          <div>
            <dt>Artigos verificados</dt>
            <dd>{posts.length.toString().padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Na fila de pesquisa</dt>
            <dd>{produtosNaFila.length.toString().padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Palpites permitidos</dt>
            <dd>00</dd>
          </div>
        </dl>
        <p class="instrument-note">
          Um campo sem confirmação aparece como “não verificado”.
        </p>
      </aside>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Fichas técnicas</p>
        <h2>Compatibilidade, sem letras miúdas.</h2>
      </div>
      <a class="text-link" href="/produtos/">Ver todos os produtos →</a>
    </div>
    <div class="product-grid">
      {produtosPublicados.map((produto) => <ProductCard produto={produto} />)}
    </div>
  </section>

  <section class="section section-ink">
    <div class="shell">
      <div class="section-heading section-heading-light">
        <div>
          <p class="eyebrow">Respostas diretas</p>
          <h2>Guias feitos a partir dos dados.</h2>
        </div>
        <a class="text-link text-link-light" href="/artigos/">Ver todos os guias →</a>
      </div>
      <div class="article-grid">
        {posts.slice(0, 3).map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="manifesto">
      <p class="eyebrow">Nossa regra</p>
      <blockquote>
        “Não verificado” é uma resposta melhor do que uma compatibilidade inventada.
      </blockquote>
      <p>
        Fabricante, manual e página oficial têm prioridade. Anúncio de marketplace
        ajuda a acompanhar preço, mas não substitui a fonte técnica.
      </p>
      <a class="button button-primary" href="/como-verificamos/">Como a ficha é montada</a>
    </div>
  </section>
</BaseLayout>
