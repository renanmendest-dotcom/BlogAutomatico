---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import ProductCard from "../components/ProductCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  produtosPublicados
} from "../lib/produtos";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.rascunho)
  .sort(
    (a, b) =>
      b.data.atualizado_em.getTime() - a.data.atualizado_em.getTime()
  );

const caminhos = [
  {
    numero: "2",
    titulo: "Meu cabelo é ondulado",
    texto: "Quero definição leve, movimento e menos produto acumulado.",
    href: "/ondulados/"
  },
  {
    numero: "3",
    titulo: "Meu cabelo é cacheado",
    texto: "Quero equilibrar definição, maciez e duração no day after.",
    href: "/cacheados/"
  },
  {
    numero: "4",
    titulo: "Meu cabelo é crespo",
    texto: "Quero retenção de umidade, cuidado e finalização sem receita pronta.",
    href: "/crespos/"
  },
  {
    numero: "?",
    titulo: "Ainda não sei",
    texto: "Quero entender meu fio antes de comprar mais um produto.",
    href: "/descobrir-meu-cabelo/"
  }
];
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Seu fio vem primeiro</p>
        <h1>
          Seu cabelo.<br />
          Suas regras.<br />
          <em>Sem drama.</em>
        </h1>
        <p class="hero-lead">
          Quer entender seu cabelo e escolher produtos sem cair em promessa
          bonita demais? Vem comigo. A gente simplifica tudo.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#meu-cabelo">
            Quero começar
          </a>
          <a class="text-link" href="/artigos/">
            Ver os guias <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="curve-card" aria-label="Mapa de curvaturas">
        <div class="curve-orbit" aria-hidden="true">
          <span class="orbit-one"></span>
          <span class="orbit-two"></span>
          <span class="orbit-three"></span>
        </div>
        <p class="curve-card-kicker">Spoiler: seu cabelo não é uma fórmula</p>
        <div class="curve-numbers" aria-hidden="true">
          <span>2</span><span>3</span><span>4</span>
        </div>
        <p>
          Os números ajudam, claro. Mas textura, quantidade e até o clima entram
          nessa conversa também.
        </p>
      </aside>
    </div>
  </section>

  <div class="topic-ribbon" aria-label="Assuntos do blog">
    <div>
      <span>Finalização</span><i aria-hidden="true">✦</i>
      <span>Day after</span><i aria-hidden="true">✦</i>
      <span>Produtos</span><i aria-hidden="true">✦</i>
      <span>Cachos sem mistério</span><i aria-hidden="true">✦</i>
      <span>Ondas com movimento</span>
    </div>
  </div>

  <section class="section shell" id="meu-cabelo">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Encontre seu caminho</p>
        <h2>Qual é a dúvida de hoje?</h2>
      </div>
      <p class="section-intro">
        Escolha a frase que parece com o seu cabelo agora. Sem prova, sem regra
        rígida e sem complicação.
      </p>
    </div>

    <div class="path-grid">
      {
        caminhos.map((caminho) => (
          <a class="path-card" href={caminho.href}>
            <span class="path-number">{caminho.numero}</span>
            <div>
              <h3>{caminho.titulo}</h3>
              <p>{caminho.texto}</p>
            </div>
            <span class="path-arrow" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Respostas que ajudam de verdade</p>
          <h2>Chega de abrir dez abas para tirar uma dúvida.</h2>
        </div>
        <a class="text-link" href="/artigos/">
          Ver todos os guias <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="article-layout-home">
        {
          posts.map((post, index) => (
            <ArticleCard post={post} destaque={index === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
          <p class="eyebrow">Achadinhos da Curva Viva</p>
          <h2>Produtos que conversam com a sua rotina.</h2>
      </div>
      <p class="section-intro">
        Tem creme, gelatina e opções para diferentes tipos de finalização.
        Escolha pelo que seu cabelo está pedindo, não só pela embalagem bonita.
      </p>
    </div>

    <div class="product-grid">
      {
        produtosPublicados.map((produto) => (
          <ProductCard produto={produto} />
        ))
      }
    </div>
  </section>

  <section class="section beauty-break">
    <div class="shell beauty-break-grid">
      <div>
        <p class="eyebrow">Um lembrete amigo</p>
        <h2>Você não precisa de uma prateleira lotada para ter um cabelo lindo.</h2>
      </div>
      <div class="beauty-tips">
        <div><span>01</span><p>Descubra primeiro o que está incomodando.</p></div>
        <div><span>02</span><p>Escolha um produto com uma função clara.</p></div>
        <div><span>03</span><p>Teste com calma antes de mudar tudo de novo.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
