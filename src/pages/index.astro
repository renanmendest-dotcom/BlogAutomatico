---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import ProductCard from "../components/ProductCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { produtosPublicados } from "../lib/produtos";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.rascunho)
  .sort(
    (a, b) => b.data.atualizado_em.getTime() - a.data.atualizado_em.getTime()
  );

const caminhos = [
  {
    titulo: "Ondulado",
    chamada: "Movimento sem peso",
    texto: "Definição leve, ondas que duram e menos produto acumulado.",
    href: "/ondulados/",
    avatar: "/avatares/ondulada.webp",
    alt: "Ilustração de uma mulher de cabelo ondulado"
  },
  {
    titulo: "Cacheado",
    chamada: "Definição com maciez",
    texto: "Equilibrar definição, maciez e um day after que sobrevive.",
    href: "/cacheados/",
    avatar: "/avatares/cacheada.webp",
    alt: "Ilustração de uma mulher de cabelo cacheado"
  },
  {
    titulo: "Crespo",
    chamada: "Umidade que fica",
    texto: "Retenção de umidade, cuidado e finalização sem receita pronta.",
    href: "/crespos/",
    avatar: "/avatares/crespa.webp",
    alt: "Ilustração de uma mulher de cabelo crespo"
  }
];
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Seu fio vem primeiro</p>
        <h1>
          Seu cabelo.<br />
          Suas regras.<br />
          <em>Sem drama.</em>
        </h1>
        <p class="hero-lead">
          Quer entender seu cabelo e escolher produtos sem cair em promessa
          bonita demais? Vem comigo. A gente simplifica tudo.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#meu-cabelo">Quero começar</a>
          <a class="text-link" href="/artigos/">
            Ver os guias <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-portraits">
        {
          caminhos.map((caminho) => (
            <span class="hero-portrait">
              <img
                src={caminho.avatar}
                alt={caminho.alt}
                width="480"
                height="480"
                fetchpriority="high"
              />
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <div class="topic-ribbon" aria-label="Assuntos do blog">
    <div>
      <span>Finalização</span><i aria-hidden="true">✦</i>
      <span>Day after</span><i aria-hidden="true">✦</i>
      <span>Produtos</span><i aria-hidden="true">✦</i>
      <span>Cachos sem mistério</span><i aria-hidden="true">✦</i>
      <span>Ondas com movimento</span>
    </div>
  </div>

  <section class="section shell" id="meu-cabelo">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Encontre seu caminho</p>
        <h2>Qual é a dúvida de hoje?</h2>
      </div>
      <p class="section-intro">
        Escolha a curvatura que mais parece com a sua. Sem prova, sem regra
        rígida e sem complicação.
      </p>
    </div>

    <div class="curvature-grid">
      {
        caminhos.map((caminho) => (
          <a class="curvature-card" href={caminho.href}>
            <span class="curvature-portrait">
              <img
                src={caminho.avatar}
                alt={caminho.alt}
                width="480"
                height="480"
                loading="lazy"
              />
            </span>
            <span class="curvature-kicker">{caminho.chamada}</span>
            <h3>{caminho.titulo}</h3>
            <p>{caminho.texto}</p>
            <span class="curvature-go">
              Ver os guias <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))
      }

      <a class="curvature-card is-unknown" href="/descobrir-meu-cabelo/">
        <span class="curvature-portrait is-mark" aria-hidden="true">?</span>
        <span class="curvature-kicker">Sem pressa</span>
        <h3>Ainda não sei</h3>
        <p>Quero entender meu fio antes de comprar mais um produto.</p>
        <span class="curvature-go">
          Descobrir agora <span aria-hidden="true">↗</span>
        </span>
      </a>
    </div>
  </section>

  <section class="trust-band">
    <div class="shell trust-grid">
      <div class="trust-lead">
        <p class="eyebrow">Por que confiar aqui</p>
        <h2>Toda indicação tem de onde veio.</h2>
      </div>
      <div class="trust-items">
        <div>
          <strong>Fontes abertas</strong>
          <p>
            Todo guia termina mostrando de onde a informação saiu, com link e
            data. Você confere se quiser.
          </p>
        </div>
        <div>
          <strong>Sem teste inventado</strong>
          <p>
            Quando é proposta da marca, está escrito que é proposta da marca.
            A gente não finge ter testado o que não testou.
          </p>
        </div>
        <div>
          <strong>Escolha pelo resultado</strong>
          <p>
            A recomendação explica em qual etapa o produto entra e qual
            problema ele resolve, não só o que a embalagem promete.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Respostas que ajudam de verdade</p>
          <h2>Chega de abrir dez abas para tirar uma dúvida.</h2>
        </div>
        <a class="text-link" href="/artigos/">
          Ver todos os guias <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="article-layout-home">
        {
          posts.map((post, index) => (
            <ArticleCard post={post} destaque={index === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Produtos conferidos</p>
        <h2>Produtos que conversam com a sua rotina.</h2>
      </div>
      <p class="section-intro">
        Tem creme, gelatina e opções para diferentes tipos de finalização.
        Escolha pelo que seu cabelo está pedindo, não só pela embalagem bonita.
      </p>
    </div>

    <div class="product-grid">
      {produtosPublicados.map((produto) => <ProductCard produto={produto} />)}
    </div>
  </section>

  <section class="section beauty-break">
    <div class="shell beauty-break-grid">
      <div>
        <p class="eyebrow">Um lembrete amigo</p>
        <h2>Você não precisa de uma prateleira lotada para ter um cabelo lindo.</h2>
      </div>
      <div class="beauty-tips">
        <div><span>01</span><p>Descubra primeiro o que está incomodando.</p></div>
        <div><span>02</span><p>Escolha um produto com uma função clara.</p></div>
        <div><span>03</span><p>Teste com calma antes de mudar tudo de novo.</p></div>
      </div>
    </div>
  </section>

  <section class="brand-close">
    <div class="shell">
      <p class="eyebrow">Curva Viva</p>
      <h2>Ondulado, cacheado ou crespo: tem guia para o seu.</h2>
      <a class="text-link" href="/artigos/">
        Ver todos os guias <span aria-hidden="true">↗</span>
      </a>
    </div>

    <img
      class="brand-close-art"
      src="/avatares/corpo-inteiro/trio-fecho.webp"
      alt="Ilustração das três personagens da Curva Viva, de corpo inteiro"
      width="1100"
      height="1010"
      loading="lazy"
    />
  </section>
</BaseLayout>
