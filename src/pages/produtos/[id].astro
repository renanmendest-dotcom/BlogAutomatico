---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatarData,
  produtosPublicados,
  resumoCurvaturas,
  rotuloCategoria,
  type ProdutoPublicado
} from "../../lib/produtos";

export function getStaticPaths() {
  return produtosPublicados.map((produto) => ({
    params: { id: produto.id },
    props: { produto }
  }));
}

interface Props {
  produto: ProdutoPublicado;
}

const { produto } = Astro.props;
const postsRelacionados = (await getCollection("posts"))
  .filter(
    (post) =>
      !post.data.rascunho && post.data.produtos.includes(produto.id)
  )
  .slice(0, 3);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: produto.nome,
  brand: {
    "@type": "Brand",
    name: produto.marca
  },
  description: produto.descricao,
  category: rotuloCategoria(produto.categoria),
  additionalProperty: produto.destaques.map((item) => ({
    "@type": "PropertyValue",
    name: item.rotulo,
    value: item.valor
  }))
};
---

<BaseLayout titulo={produto.nome} descricao={produto.descricao}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <header class="product-hero">
    <div class="shell product-hero-grid">
      <div>
        <a class="back-link" href="/produtos/">← Todos os produtos</a>
        <p class="eyebrow">
          {produto.marca} · {rotuloCategoria(produto.categoria)}
        </p>
        <h1>{produto.nome}</h1>
        <p class="product-description">{produto.descricao}</p>
        <div class="verified-row">
          <span class="evidence-pill">Análise documental</span>
          <span>Atualizada em {formatarData(produto.verificadoEm)}</span>
        </div>
      </div>

      <aside class="product-profile" aria-label="Resumo do produto">
        <span class="profile-label">Perfil rápido</span>
        <dl>
          <div>
            <dt>Para quem</dt>
            <dd>{resumoCurvaturas(produto.perfil.curvaturas)}</dd>
          </div>
          <div>
            <dt>Textura</dt>
            <dd>{produto.perfil.textura}</dd>
          </div>
          <div>
            <dt>Intensidade</dt>
            <dd>{produto.perfil.intensidade}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </header>

  <section class="section shell product-detail-grid">
    <div>
      <p class="eyebrow">O que encontramos</p>
      <h2 class="content-title">A ficha em linguagem simples.</h2>

      <dl class="detail-list">
        {
          produto.destaques.map((destaque) => (
            <div>
              <dt>{destaque.rotulo}</dt>
              <dd>{destaque.valor}</dd>
            </div>
          ))
        }
      </dl>

      <div class="objective-block">
        <p class="eyebrow">Objetivos apresentados</p>
        <ul class="tag-list">
          {produto.perfil.objetivos.map((objetivo) => <li>{objetivo}</li>)}
        </ul>
      </div>

      <div class="editorial-note">
        <p class="eyebrow">Limite desta ficha</p>
        <p>{produto.analise.nota}</p>
      </div>
    </div>

    <aside class="purchase-panel">
      <p class="eyebrow">Onde comprar</p>
      {
        produto.oferta.url ? (
          <>
            <a
              class="button button-primary button-full"
              href={produto.oferta.url}
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Ver na {produto.oferta.loja}
            </a>
            <p class="affiliate-note">
              Recebemos comissão pelas compras qualificadas. Isso não altera o
              preço para você.
            </p>
          </>
        ) : (
          <>
            <strong>Oferta em conferência</strong>
            <p>
              O link só aparece depois que a loja, a versão do produto e o
              endereço de afiliado forem confirmados.
            </p>
          </>
        )
      }

      <div class="source-list">
        <p class="eyebrow">Fontes consultadas</p>
        <ol>
          {
            produto.fontes.map((fonte) => (
              <li>
                <a href={fonte.url} target="_blank" rel="noopener">
                  {fonte.titulo}
                </a>
                <span>Acesso em {formatarData(fonte.acessadoEm)}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </aside>
  </section>

  {
    postsRelacionados.length > 0 && (
      <section class="section section-soft">
        <div class="shell">
          <p class="eyebrow">Continue a pesquisa</p>
          <h2 class="content-title">Guias que citam este produto.</h2>
          <div class="related-links">
            {postsRelacionados.map((post) => (
              <a href={`/artigos/${post.id}/`}>
                <span>{post.data.titulo}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
