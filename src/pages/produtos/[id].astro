---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  informacaoProdutoPublicavel,
  linkCompraProduto,
  produtosPublicados,
  resumoCurvaturas,
  rotuloCategoria,
  type ProdutoPublicado
} from "../../lib/produtos";

export function getStaticPaths() {
  return produtosPublicados.map((produto) => ({
    params: { id: produto.id },
    props: { produto }
  }));
}

interface Props {
  produto: ProdutoPublicado;
}

const { produto } = Astro.props;
const postsRelacionados = (await getCollection("posts"))
  .filter(
    (post) =>
      !post.data.rascunho && post.data.produtos.includes(produto.id)
  )
  .slice(0, 3);
const linkCompra = linkCompraProduto(produto);
if (!linkCompra) {
  throw new Error(`O produto "${produto.id}" precisa de um link de compra.`);
}
const destaquesPublicaveis = produto.destaques.filter((destaque) =>
  informacaoProdutoPublicavel(destaque.valor)
);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: produto.nome,
  brand: {
    "@type": "Brand",
    name: produto.marca
  },
  description: produto.descricao,
  category: rotuloCategoria(produto.categoria),
  additionalProperty: destaquesPublicaveis.map((item) => ({
    "@type": "PropertyValue",
    name: item.rotulo,
    value: item.valor
  }))
};
---

<BaseLayout titulo={produto.nome} descricao={produto.descricao}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <header class="product-hero product-commercial-hero">
    <div class="shell product-hero-grid">
      <div>
        <a class="back-link" href="/produtos/">← Todos os produtos</a>
        <p class="eyebrow">
          {produto.marca} · {rotuloCategoria(produto.categoria)}
        </p>
        <h1>{produto.nome}</h1>
        <p class="product-description">{produto.descricao}</p>
      </div>

      <aside class="product-showcase" aria-label="Resumo do produto">
        {
          produto.imagem && (
            <div class="product-detail-image">
              <img
                src={produto.imagem.src}
                alt={produto.imagem.alt}
                width="640"
                height="640"
              />
            </div>
          )
        }
        <div class="product-profile">
          <span class="profile-label">Combina com a sua rotina?</span>
          <dl>
            <div>
              <dt>Para quem</dt>
              <dd>{resumoCurvaturas(produto.perfil.curvaturas)}</dd>
            </div>
            <div>
              <dt>Textura</dt>
              <dd>{produto.perfil.textura}</dd>
            </div>
            {
              informacaoProdutoPublicavel(produto.perfil.intensidade) && (
                <div>
                  <dt>Intensidade</dt>
                  <dd>{produto.perfil.intensidade}</dd>
                </div>
              )
            }
          </dl>
        </div>
        <a
          class="button button-primary button-full purchase-button product-hero-purchase"
          href={linkCompra}
          target="_blank"
          rel="nofollow sponsored noopener"
        >
          Ver preço e disponibilidade
        </a>
      </aside>
    </div>
  </header>

  <section class="section shell product-detail-grid product-commercial-content">
    <div>
      <p class="eyebrow">Resumo sem enrolação</p>
      <h2 class="content-title">O que vale saber antes de escolher.</h2>

      <dl class="detail-list">
        {
          destaquesPublicaveis.map((destaque) => (
            <div>
              <dt>{destaque.rotulo}</dt>
              <dd>{destaque.valor}</dd>
            </div>
          ))
        }
      </dl>

      <div class="objective-block">
        <p class="eyebrow">Objetivos apresentados</p>
        <ul class="tag-list">
          {produto.perfil.objetivos.map((objetivo) => <li>{objetivo}</li>)}
        </ul>
      </div>

    </div>

    <aside class="purchase-panel product-sources-panel">
      <div class="source-list source-list-only">
        <p class="eyebrow">Quer conferir os detalhes?</p>
        <ol>
          {
            produto.fontes.map((fonte) => (
              <li>
                <a href={fonte.url} target="_blank" rel="noopener">
                  {fonte.titulo}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </aside>
  </section>

  {
    postsRelacionados.length > 0 && (
      <section class="section section-soft">
        <div class="shell">
          <p class="eyebrow">Para continuar</p>
          <h2 class="content-title">Veja como usar esse produto na rotina.</h2>
          <div class="related-links">
            {postsRelacionados.map((post) => (
              <a href={`/artigos/${post.id}/`}>
                <span>{post.data.titulo}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
