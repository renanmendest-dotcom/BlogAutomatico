---
import ProductCard from "../../components/ProductCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  produtosPublicados
} from "../../lib/produtos";
---

<BaseLayout
  titulo="Produtos para cabelos ondulados, cacheados e crespos"
  descricao="Produtos para cabelos ondulados, cacheados e crespos explicados de um jeito simples e fácil de comparar."
>
  <header class="page-hero shell">
    <p class="eyebrow">Escolha sem se perder</p>
    <h1>O produto certo para o que seu cabelo pede agora.</h1>
    <p>
      Quer mais definição, maciez ou um day after que sobreviva? Compare as
      opções com calma e escolha pelo resultado que você procura.
    </p>
  </header>

  <section class="section shell section-first">
    <div class="filter-notes" aria-label="Dicas para escolher">
      <span>Para definir</span>
      <span>Para dar maciez</span>
      <span>Para segurar o day after</span>
    </div>

    <div class="product-grid">
      {
        produtosPublicados.map((produto) => (
          <ProductCard produto={produto} />
        ))
      }
    </div>
  </section>

  <section class="queue-strip">
    <div class="shell queue-inner">
      <div>
        <p class="eyebrow">Tem mais vindo aí</p>
        <h2>Novos queridinhos entram por aqui.</h2>
      </div>
      <p>
        Widi Care, Soul Power, Apse, Novex, Seda, Inoar e Arvensis estão na
        nossa lista. Sim, a bancada vai ficar bem mais recheada.
      </p>
    </div>
  </section>
</BaseLayout>
